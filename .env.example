# Kingdom Agency — Environment Variables
# Copy to .env and fill in real values

# Database
POSTGRES_USER=kingdom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kingdom_agency
DATABASE_URL=postgresql+asyncpg://kingdom:changeme@db:5432/kingdom_agency
DATABASE_URL_SYNC=postgresql://kingdom:changeme@db:5432/kingdom_agency

# Auth
SECRET_KEY=change-this-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_NAME=Kingdom Agency
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_AUTH=10/minute
